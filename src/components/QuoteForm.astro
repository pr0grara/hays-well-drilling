---
/**
 * QuoteForm.astro — primary lead-capture form.
 * Backend is chosen in site.ts:
 *   - Web3Forms: formEndpoint = api.web3forms.com/submit + formAccessKey
 *   - Formspree:  formEndpoint = formspree.io/f/xxxx (no key)
 *   - Worker/custom: any endpoint accepting multipart/form-data POST → 2xx
 *   - Call-only:  formEndpoint = "" → submit disabled, shows "call us instead"
 */
import { SITE, tel } from '@config/site';

interface Props {
  source?: string;
  heading?: string;
  sub?: string;
}
const {
  source = 'website',
  heading = 'Request a Free Quote',
  sub = 'Tell us where your well is and what’s going on — we’ll call you back with a quote.',
} = Astro.props;

// Turnstile sitekey — Cloudflare TEST key (always passes). Swap for the real widget
// sitekey once minted in the dashboard; also set the TURNSTILE_SECRET worker secret.
const TURNSTILE_SITEKEY = '1x00000000000000000000AA';
---

<div class="card quote-form" id="quote">
  <h3>{heading}</h3>
  <p class="muted">{sub}</p>

  <form id="lead-form" novalidate>
    <input type="hidden" name="source" value={source} />

    <!-- honeypot: real people leave this empty -->
    <div class="hp" aria-hidden="true">
      <label>Company Website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="field">
      <label for="lf-name">Name <span class="req">*</span></label>
      <input id="lf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="lf-phone">Phone</label>
      <input id="lf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label for="lf-email">Email <span class="req">*</span></label>
      <input id="lf-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="lf-address">Property address or area</label>
      <input id="lf-address" name="address" type="text" placeholder="e.g. Dripping Springs, or a street near Wimberley" />
    </div>
    <div class="field">
      <label for="lf-message">What’s going on — new well, no water, low pressure, or a pump issue?</label>
      <textarea id="lf-message" name="message" rows="4" placeholder="New build that needs a well, no water, low pressure, a pump that keeps cycling, dirty water, or an inspection for a home sale… and anything you know about the well’s depth or pump."></textarea>
    </div>
    <div class="field">
      <label for="lf-photo">Photo (optional)</label>
      <input id="lf-photo" name="photo" type="file" accept="image/*" />
    </div>

    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="light" style="margin:12px 0;"></div>

    <button type="submit" class="btn btn-primary btn-lg btn-block" id="lf-submit">
      Send My Request
    </button>
    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

    <p class="muted or-call">
      Prefer to talk now? Call <a href={tel()}>{SITE.phoneDisplay}</a>.
    </p>
  </form>
</div>

<style>
  .quote-form h3 {
    margin-bottom: 4px;
  }
  .or-call {
    margin: 14px 0 0;
    text-align: center;
  }
</style>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setStatus(msg: string, type: '' | 'error' | 'success') {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = 'form-status' + (type ? ' ' + type : '');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    setStatus('', '');
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries()) as Record<string, string>;

    if (data.company_website) return; // honeypot tripped — silently drop
    if (!data.name || !data.name.trim()) return setStatus('Please enter your name.', 'error');
    if (!EMAIL_RE.test((data.email || '').trim()))
      return setStatus('Please enter a valid email address.', 'error');
  
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Submitting…';
    try {
      const payload: Record<string, string> = {};
      for (const [k, v] of fd.entries()) { if (typeof v === 'string') payload[k] = v; }
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = await res.json().catch(() => ({ success: res.ok }));
      if (!res.ok || !out.success) throw new Error(out.message || 'bad status');
      form.reset();
      if ((window as any).turnstile) (window as any).turnstile.reset();
      setStatus("🎉 Thanks! We've received your request and will call you shortly.", 'success');
    } catch (err: any) {
      setStatus(err?.message || 'Sorry, something went wrong. Please call us instead.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
    }
  });
</script>
